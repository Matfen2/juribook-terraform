# Copier ce fichier en terraform.tfvars et adapter les valeurs.
# NE JAMAIS committer terraform.tfvars (il est dans .gitignore).
#
# Les clés d'accès Scaleway (SCW_ACCESS_KEY, SCW_SECRET_KEY) ne
# vont PAS ici : configure-les en variables d'environnement,
# voir versions.tf pour le détail (ou un fichier .env local,
# jamais committé, jamais partagé).

scw_region = "fr-par"
scw_zone   = "fr-par-1"

project_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

environment  = "dev"
project_name = "juribook"

# ── Kubernetes (Kapsule) ──────────────────────────────────────
# ⚠️ Vérifie la version disponible dans la console AVANT d'appliquer :
# Containers > Kubernetes > Create Cluster > menu déroulant version.
k8s_version       = "1.36.1"
k8s_node_type     = "DEV1-L"   # 8 Go RAM — DEV1-M (4 Go) cause des OOMKilled en pratique
k8s_pool_size     = 1
k8s_pool_min_size = 1
k8s_pool_max_size = 3

# ── Base de données managée (RDB) ─────────────────────────────
db_node_type      = "DB-DEV-S"
db_engine         = "PostgreSQL-16"
db_volume_type    = "sbs_5k"
db_volume_size_gb = 10
db_admin_username = "juribook_admin"

# Contraintes Scaleway : 8-128 caractères, 1 chiffre, 1 majuscule,
# 1 minuscule, 1 caractère spécial minimum.
db_admin_password = "CHANGE_ME_Strong_Password1!"
db_app_password   = "CHANGE_ME_App_Password1!"

# ── DNS ──────────────────────────────────────────────────────
domain_name   = ""   # ex: "juribook.fr" — laisser vide pour ignorer le DNS
ingress_lb_ip = ""   # à renseigner après le déploiement K8s (voir README)
